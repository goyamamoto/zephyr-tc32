# SPDX-License-Identifier: Apache-2.0

if SOC_SERIES_TLSR825X

config NUM_IRQS
	default 32

config SYS_CLOCK_EXISTS
	default y

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 16000000

# TC32 has neither a 64-bit ALU nor a hardware divider, so 64-bit tick
# arithmetic turns into library calls on the timeout hot path. Measured on
# tlsr8258_tb03f at 10 kHz ticks: sys_clock_announce() drops from 24216 to
# 21816 cycles and a k_msleep() lands 11500 cycles sooner. The cost is that
# absolute timeouts (K_TIMEOUT_ABS_*) are no longer available; nothing in
# this port uses them.
config TIMEOUT_64BIT
	default n

config XIP
	default y

config HAS_FLASH_LOAD_OFFSET
	default y if BOOTLOADER_MCUBOOT

config FLASH_BASE_ADDRESS
	default 0x0

config FLASH_SIZE
	default 512

config SRAM_BASE_ADDRESS
	default 0x840000

config SRAM_SIZE
	default 64

config MAIN_STACK_SIZE
	default 2048

config IDLE_STACK_SIZE
	default 1024

config TEST_EXTRA_STACK_SIZE
	default 1024

endif # SOC_SERIES_TLSR825X
